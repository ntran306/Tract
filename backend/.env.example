# Copy to .env and fill in. Values come from the Supabase dashboard (project tract-dev).

# Connect -> Session pooler URI (port 5432). Transaction pooler (:6543) breaks Alembic.
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres

# Project URL (Settings -> API). Used to build the JWKS URL for JWT verification.
SUPABASE_URL=https://<project-ref>.supabase.co

# Leave empty for new projects (JWKS/ES256 is used). Only set for legacy HS256 projects.
SUPABASE_JWT_SECRET=

CORS_ORIGINS=http://localhost:5173

# stub | claude  (claude requires ANTHROPIC_API_KEY and costs money per message)
AGENT_PROVIDER=stub
ANTHROPIC_API_KEY=

# M2: free key from https://www.huduser.gov/portal/dataset/fmr-api.html
HUD_API_TOKEN=

# M4: https://resend.com
RESEND_API_KEY=
